{% extends 'base.html.twig' %}

{% block title %}
    {{ employe.prenom }} {{ employe.nom }} - TaskLinker
{% endblock %}

{% block page_title %}
    {{ employe.prenom }} {{ employe.nom }}
{% endblock %}

{% block body %}
    {{ form_start(form) }}

        {{ form_row(form.nom) }}

        {{ form_row(form.prenom) }}

        {{ form_row(form.email) }}

        <div class="form-flex">
            {{ form_row(form.dateEntree) }}

            {{ form_row(form.statut) }}
        </div>

        <button
            type="submit"
            class="button button-submit"
        >
            Enregistrer
        </button>

    {{ form_end(form) }}
{% endblock %}