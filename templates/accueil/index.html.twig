{% extends 'base.html.twig' %}

{% block title %}
    Liste des projets - TaskLinker
{% endblock %}

{% block page_title %}
    Projets
{% endblock %}

{% block body %}
    <div id="projects-container">
        {% for projet in projets %}
            <article class="card-project">
                <a href="{{ path('app_projet_show', {id: projet.id}) }}">
                    <h2>{{ projet.nom }}</h2>
                </a>

                <div class="card-project-icons">
                    <a
                        href="{{ path('app_projet_edit', {id: projet.id}) }}"
                        aria-label="Modifier {{ projet.nom }}"
                    >
                        <i class="fa-solid fa-pen"></i>
                    </a>
                    <form
                        method="post"
                        action="{{ path('app_projet_archive', {id: projet.id}) }}"
                        class="archive-project-form"
                        onsubmit="return confirm('Archiver ce projet ?');"
                    >
                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('archive' ~ projet.id) }}"
                        >

                        <button
                            type="submit"
                            class="archive-project-button"
                            aria-label="Archiver {{ projet.nom }}"
                        >
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </form>
                </div>
            </article>
        {% else %}
            <p>Aucun projet en cours.</p>
        {% endfor %}

        <article class="card-project">
            <a href="{{ path('app_projet_new') }}">
                <i class="fa-solid fa-circle-plus add-project-icon"></i>
                <h2>Ajouter un projet</h2>
            </a>
        </article>
    </div>
{% endblock %}